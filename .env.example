PORT=3000
# Replace both with distinct random secrets. Keep .env out of Git.
PAYHUB_TOKEN=replace-with-random-payhub-token
PAYHUB_CLIENT_ID=replace-with-payhub-client-id
PAYHUB_CLIENT_SECRET=replace-with-random-payhub-client-secret
ADMIN_KEY=replace-with-different-random-admin-key
