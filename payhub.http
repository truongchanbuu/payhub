# VS Code REST Client. Credentials come from the editor process environment.
# Set PAYHUB_TOKEN and ADMIN_KEY; token requests also need the client credentials.
@baseUrl = https://payhub-2u1i.onrender.com
# For Render, replace baseUrl with your deployed HTTPS URL.
@testId = manual-inspection-001
@merchantRef = HTTP-DEMO-001
@salesforceMerchantRef = RR-2610-00015

### Health check
GET {{baseUrl}}/healthz

### Refund outcome event snapshot (pretty JSON)
# Returns the latest retained POS/App demo events and subscriber state.
GET {{baseUrl}}/__mock/refund-events?limit=20
X-Admin-Key: {{$processEnv ADMIN_KEY}}

### Live refund outcome event tail (pretty SSE)
# This request stays open. Stop it after the demo.
GET {{baseUrl}}/__mock/refund-events/tail
X-Admin-Key: {{$processEnv ADMIN_KEY}}
Accept: text/event-stream

### Read the global scenario
GET {{baseUrl}}/__mock/scenario
X-Admin-Key: {{$processEnv ADMIN_KEY}}

### Make every new Salesforce refund time out
# Run UAT cases serially, then reset the scenario below.
# Copy the JSON part of one line below over the active body:
# 200 SUCCESS immediately:              { "scenario": "SUCCESS" }
# PENDING, then SUCCESS callback:        { "scenario": "PENDING_SUCCESS" }
# PENDING, then FAILED callback:         { "scenario": "PENDING_FAILED" }
# 422 INVALID_AMOUNT:                    { "scenario": "INVALID_AMOUNT" }
# 500 on every attempt:                  { "scenario": "HTTP_500" }
# 503 on every attempt:                  { "scenario": "HTTP_503" }
# 503 x3, SUCCESS on attempt 4:          { "scenario": "RETRY_503_3" }
# 503 x2, SUCCESS on attempt 3:          { "scenario": "RETRY_503_2_SUCCESS" }
# Exceeds the Salesforce timeout:        { "scenario": "TIMEOUT" }
# Accepted once; retry replays SUCCESS:  { "scenario": "SUCCESS_THEN_TIMEOUT" }
# PENDING, then two SUCCESS callbacks:   { "scenario": "DUPLICATE_CALLBACK" }
PUT {{baseUrl}}/__mock/scenario
X-Admin-Key: {{$processEnv ADMIN_KEY}}
Content-Type: application/json
{
  "scenario": "TIMEOUT"
}

### Reset the global scenario to SUCCESS
DELETE {{baseUrl}}/__mock/scenario
X-Admin-Key: {{$processEnv ADMIN_KEY}}

### Salesforce transaction timeline by Return Request number
# Salesforce requests without X-Mock-Test-Id use the "default" namespace.
GET {{baseUrl}}/__mock/transactions?testId=default&merchantRef={{salesforceMerchantRef}}
X-Admin-Key: {{$processEnv ADMIN_KEY}}

### Salesforce traces (requests without X-Mock-Test-Id use "default")
# Read-only. Save the JSON response before PayHub restarts or redeploys.
GET {{baseUrl}}/__mock/attempts?testId=default
X-Admin-Key: {{$processEnv ADMIN_KEY}}

### Transaction timeline for the manual refund below
GET {{baseUrl}}/__mock/transactions?testId={{testId}}&merchantRef={{merchantRef}}
X-Admin-Key: {{$processEnv ADMIN_KEY}}

### Traces for the manual refund below
GET {{baseUrl}}/__mock/attempts?testId={{testId}}
X-Admin-Key: {{$processEnv ADMIN_KEY}}

### Request an OAuth2 token (optional when PAYHUB_TOKEN is already configured)
# REST Client encodes the Basic credentials. Use the returned access_token as PAYHUB_TOKEN.
POST {{baseUrl}}/v1/token
Authorization: Basic {{$processEnv PAYHUB_CLIENT_ID}} {{$processEnv PAYHUB_CLIENT_SECRET}}
Content-Type: application/x-www-form-urlencoded

grant_type=client_credentials

### Create a manual mock refund (writes state; does not submit a Salesforce inspection)
# Keep real Salesforce RR codes out of this manual request.
# Repeating this request replays the accepted refund with the same idempotency key.
# Change testId and merchantRef for a new test. SUCCESS does not send a callback.
POST {{baseUrl}}/v1/refunds
Authorization: Bearer {{$processEnv PAYHUB_TOKEN}}
Idempotency-Key: {{merchantRef}}
X-Mock-Test-Id: {{testId}}
X-Mock-Scenario: SUCCESS
Content-Type: application/json

{
  "merchantRef": "{{merchantRef}}",
  "orderNumber": "HTTP-DEMO-ORDER-001",
  "amount": 100000,
  "currency": "VND",
  "reason": "CUSTOMER_RETURN"
}
